# Copy to .env and fill in. Never commit .env.

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server side only (Edge Functions). Never ship in the app.
SUPABASE_SECRET_KEY=

# Google Cloud (OAuth + Google Health API)
GOOGLE_CLOUD_PROJECT_NUMBER=
# Web client: Supabase sign-in and the Google Health connect flow
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Native Google sign-in client IDs (not secret)
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=

# Google Health webhooks: the secret Google sends in the Authorization header
HEALTH_WEBHOOK_SECRET=

# Signs the OAuth `state` parameter (random 32+ bytes). Server side only.
OAUTH_STATE_SECRET=

# The Flutter app reads its public settings from .env.json (also git-ignored):
# {"SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "GOOGLE_WEB_CLIENT_ID", "GOOGLE_IOS_CLIENT_ID"}
# Run with: flutter run --dart-define-from-file=../.env.json

# Claude API. Server side only.
ANTHROPIC_API_KEY=

# Supabase database password. Server side only.
SUPABASE_DB_PASSWORD=
