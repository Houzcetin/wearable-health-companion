# Copy to .env and fill in. Never commit .env or .env.json (both are git-ignored).
# Names below were checked against the code. A name that nothing reads is marked.

# ---------------------------------------------------------------------------
# Edge Functions (supabase/functions/**)
# Set with: supabase secrets set --env-file <file> (or one NAME=value at a time).
# ---------------------------------------------------------------------------

# Provided by the hosted Supabase runtime; you do not set them there (the
# SUPABASE_ prefix is reserved). Only needed in .env for local runs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server side only. Bypasses RLS. Never ship it in the app.
SUPABASE_SERVICE_ROLE_KEY=

# Google web OAuth client (Supabase sign-in and the Google Health connect flow).
GOOGLE_OAUTH_CLIENT_ID=
# Also read from .env by `supabase config push` (supabase/config.toml, env(...)).
# The client IDs in config.toml are written out there, not read from .env.
GOOGLE_OAUTH_CLIENT_SECRET=

# Signs the OAuth `state` parameter. Random, 32+ bytes: openssl rand -base64 48
OAUTH_STATE_SECRET=

# Google Health webhooks send this as `Authorization: Bearer <secret>`.
# If it changes, update the subscriber's endpointAuthorization too (docs/SETUP.md).
HEALTH_WEBHOOK_SECRET=

# pg_cron sends this to sync-worker in the x-cron-secret header.
# Store the same value in Vault as `sync_cron_secret`.
SYNC_CRON_SECRET=

# The coach's Claude key. Server side only; set a spending limit in the console.
# Run the eval on your own computer with an in-memory key; see docs/COACH_EVAL.md.
ANTHROPIC_API_KEY=

# Optional.
# COACH_MODEL=claude-sonnet-5-5
# Per user, clamped to at most 100:
# COACH_DAILY_LIMIT=30
# Across all users:
# COACH_GLOBAL_DAILY_LIMIT=500
# Both limits count accepted questions over a rolling 24 hours, including failed answers.

# ---------------------------------------------------------------------------
# Supabase Vault (read by run_scheduled_sync(); created in the SQL editor, not
# through .env): project_url = https://<project-ref>.supabase.co
#                sync_cron_secret = the same value as SYNC_CRON_SECRET above.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Flutter app (app/lib/core/env.dart)
# Public values only, in a separate git-ignored file .env.json at the repo root:
#   {
#     "SUPABASE_URL": "https://<project-ref>.supabase.co",
#     "SUPABASE_PUBLISHABLE_KEY": "<publishable (anon) key>",
#     "GOOGLE_WEB_CLIENT_ID": "<web client id>",
#     "GOOGLE_IOS_CLIENT_ID": "<ios client id>"
#   }
# Run with: cd app && flutter run --dart-define-from-file=../.env.json
# The publishable key is the public one. It is not SUPABASE_SERVICE_ROLE_KEY.
# Without .env.json the app runs as an offline shell.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# CLI helpers (not read by our code)
# ---------------------------------------------------------------------------

# Read by the Supabase CLI for `supabase link` / `supabase db push`.
SUPABASE_DB_PASSWORD=
# Optional. Only a reference for manual gcloud/curl commands (the webhook
# subscriber is projects/<number>/subscribers/...). Use the project NUMBER.
GOOGLE_CLOUD_PROJECT_NUMBER=
